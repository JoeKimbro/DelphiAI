# Copy to .env (same folder) and adjust. .env is gitignored — never commit it.
# These defaults are for the local Docker database only.

# --- Local PostgreSQL (docker-compose) ---------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=delphi_db
DB_USER=delphi_user
DB_PASSWORD=delphi_password

# pgAdmin web UI at http://localhost:5050
PGADMIN_EMAIL=admin@delphi.local
PGADMIN_PASSWORD=admin123

# Optional. When set, it takes priority over the DB_* values above.
# Leave it unset for local dev — do NOT point it at the production database.
# DATABASE_URL=postgresql://delphi_user:delphi_password@localhost:5433/delphi_db

# --- FastAPI (all optional for local dev) -------------------------------------
# With no API key set, the API runs open — fine on localhost only.
# DELPHI_API_KEY=
# DELPHI_ADMIN_API_KEY=
# DELPHI_CORS_ORIGINS=http://localhost:3000
# DELPHI_ENABLE_DOCS=true          # serves /docs (Swagger UI)
# DELPHI_DISABLE_RATELIMIT=true
# DELPHI_MODEL_PATH=               # default: DelphiAIApp/Models/ml/artifacts/model_latest.pkl
# DELPHI_MODEL_SHA256=             # pin the model file's hash (see SETUP.md)

# --- Maintainer only: publishing models to Cloudflare R2 -----------------------
# R2_ENDPOINT_URL=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
