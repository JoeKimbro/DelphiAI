# Copy to .env.local (same folder). Next.js does not read the repo-root .env.

# Database for sign-in/sign-up (same local Docker DB as the Python side)
DATABASE_URL=postgresql://delphi_user:delphi_password@localhost:5433/delphi_db

# FastAPI backend (uvicorn DelphiAIApp.main:app --port 8000)
FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000

# Only needed if you set DELPHI_API_KEY for the API; must match it.
# DELPHI_API_KEY=
